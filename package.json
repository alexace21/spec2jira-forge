{
  "name": "spec2tickets",
  "version": "6.1.0",
  "main": "index.js",
  "license": "MIT",
  "private": true,
  "scripts": {
    "check": "node tools/check-syntax.mjs && node tools/version-drift-guard.mjs",
    "test": "node tools/run-tests.mjs",
    "build:ui": "npm --prefix static/hello-world ci && npm --prefix static/hello-world run build",
    "audit": "npm audit --omit=dev --audit-level=high",
    "ci": "npm run check && npm test && npm run build:ui"
  },
  "devDependencies": {
    "eslint": "^10.5.0",
    "eslint-plugin-react-hooks": "^7.1.1"
  },
  "dependencies": {
    "@forge/api": "^8.0.0",
    "@forge/kvs": "^2.0.0",
    "@forge/resolver": "1.7.1"
  }
}
